# API REST de referencia — Obras Públicas Temascaltepec
#
# Imagen mínima para levantar el backend Flask contra una base local. El
# despliegue gestionado usa gunicorn con la misma entrada (véase render.yaml);
# aquí se conserva ese arranque para que lo que se prueba sea lo que se
# despliega.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# psycopg2-binary trae sus ruedas, pero cryptography necesita las cabeceras
# en algunas plataformas; se instalan y se retiran en la misma capa.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

EXPOSE 5000

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
  CMD curl -fsS http://localhost:5000/api/health || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--timeout", "60", "run:app"]
