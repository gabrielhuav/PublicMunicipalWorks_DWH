PREFIX obra: <https://w3id.org/obras-mx/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# El municipio del capítulo.
SELECT ?ciclo (COUNT(?o) AS ?proyectos) (SUM(COALESCE(?p, 0.0)) AS ?pagado) WHERE {
  ?m obra:claveINEGI "15086" .
  ?o obra:enMunicipio ?m ; obra:ciclo ?ciclo .
  OPTIONAL { ?o obra:pagado ?p }
}
GROUP BY ?ciclo
ORDER BY ?ciclo
